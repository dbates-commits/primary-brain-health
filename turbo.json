{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [".env", "tsconfig.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "public/admin/**"],
      "env": [
        "TINA_TOKEN",
        "NEXT_PUBLIC_TINA_CLIENT_ID",
        "NEXT_PUBLIC_TINA_BRANCH",
        "TINA_PUBLIC_IS_LOCAL",
        "VERCEL_ENV",
        "AUTH0_ISSUER",
        "AUTH0_CLIENT_ID",
        "AUTH0_CLIENT_SECRET"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
