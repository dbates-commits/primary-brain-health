# Marketing app environment — the whole customer-facing surface lives here.
#
# The booking modal on the home page runs the real end-to-end flow (account →
# email confirmation → details → consent → Stripe Embedded Checkout → Linus
# enrollment → welcome screen), and this app also owns sign-in, the Stripe
# webhook and every transactional email. Copy this file to .env.local for local
# dev; on Vercel these are set per environment.

# --- Neon Postgres ---
# Use the pooled ("-pooler") host for serverless request handlers.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Which database the line above actually leads to: production | preview | development.
# Not a secret — it is the declaration the boot check compares against VERCEL_ENV,
# so a preview deploy holding the production branch refuses to start rather than
# writing live patient rows. Set it in every Vercel scope, next to DATABASE_URL.
#
# It also decides whether a deploy runs migrations (see vercel.json): production
# always does, preview only when this says "preview". Setting it to "preview"
# while DATABASE_URL points at production would migrate production from every
# preview build.
DATABASE_ENV="development"

# --- Linus Health Public API (sandbox defaults) ---
# Preview/dev → sandbox (the URLs below); Production → the prod URLs/audience.
LINUS_CLIENT_ID=""
LINUS_CLIENT_SECRET=""
LINUS_BASE_URL="https://dtc.us.stgint.linushealth.cloud/v1"
LINUS_TOKEN_URL="https://login.staging-integration.linus.health/oauth/token"
LINUS_AUDIENCE="https://stgint-linus-us.us.auth0.com/api/v2/"

# --- Stripe (Embedded Checkout) ---
# Local dev: TEST keys (Dashboard → Developers → API keys). Test card 4242…4242.
# The secret key is server-only; the publishable key is safe in the browser.
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Catalog Price ID charged at checkout. The amount, currency, and product name
# come from the Stripe Price/Product (the source of truth) — no hardcoded price
# in the code. Use a test-mode Price ID from the SAME account as the keys above
# (Dashboard → Product catalog, or `stripe prices create`). On Vercel, set per
# environment: sandbox price on Preview, the live price in Production.
#
# The price must be ACTIVE. Archiving it breaks checkout outright: the catalog
# lookup throws, and Stripe refuses an inactive price on the session anyway.
STRIPE_ASSESSMENT_PRICE_ID="price_..."

# Price ID for the Comprehensive ($449) package. Same account as above.
# Optional today: the Comprehensive card is not purchasable (its clinical
# fulfillment is undefined), so nothing reads this until that lands — but
# checkout throws the moment it does, so set it before enabling that CTA.
STRIPE_COMPREHENSIVE_PRICE_ID="price_..."

# Webhook signing secret — verifies inbound events at /api/stripe/webhook, the
# ONLY endpoint on the account and the fulfillment backstop behind the client
# path.
# Local dev:  run `stripe listen --forward-to localhost:3000/api/stripe/webhook`
#             and paste the printed `whsec_…` here.
# Vercel:     each hosted endpoint has its own signing secret (Dashboard →
#             Developers → Webhooks → your endpoint). Set it per environment.
STRIPE_WEBHOOK_SECRET="whsec_..."

# Keyed hash of client IPs stored on consent/audit rows.
IP_HASH_SECRET=""

# --- The Linus Engagement App ---
#
# Where a paid customer goes next: the welcome screen's single CTA, and the link
# inside the "assessment ready" email. Linus owns login and the assessments
# themselves, so this is a plain external link — no token, no session.
#
# Unset is safe: the welcome screen renders the confirmation without a button
# and says the link will follow by email. NEXT_PUBLIC_* is inlined at build
# time, so setting or changing it needs a REDEPLOY, not just an env edit.
NEXT_PUBLIC_ENGAGEMENT_APP_URL=""

# --- Booking email confirmation ---
#
# Signup is gated on confirming the email address: we mail a one-time link that
# stamps `users.email_verified` and resumes the booking at the right step.

# The one canonical public origin — every link we email (confirmation, sign-in,
# welcome) and every email asset URL is built from it.
# Local dev:  leave unset (defaults to http://localhost:3000).
# Vercel:     leave unset on Preview — it falls back to VERCEL_URL, the
#             per-deployment host, so every preview links to itself. Set it
#             explicitly in Production, where VERCEL_URL is the generated
#             *.vercel.app host rather than the real domain.
BOOKING_BASE_URL=""

# Signs the short-lived, httpOnly `pbh_booking_session` cookie that proves this
# browser confirmed an address. REQUIRED wherever the booking flow runs.
# Local dev:  generate one with `openssl rand -base64 32`.
# Vercel:     set per environment (a distinct value for prod vs preview).
BOOKING_RESUME_SECRET=""

# --- Transactional email (Resend + @pbh/emails) ---
#
# ALL optional: with RESEND_API_KEY unset, every send is a logged no-op and the
# flow works normally — no email setup needed for local dev. Nothing here gates
# a step any more: the one blocking email (the address confirmation) is sent by
# Auth0 now, not by us, so Resend only carries receipts and notifications.
#
# Local dev:  a free personal Resend account can send from the default
#             onboarding@resend.dev to its own account email, no domain
#             verification needed.
# Vercel:     set per environment once the PBH Resend account exists — separate
#             dev/prod API keys, and EMAIL_FROM on the verified domain.
RESEND_API_KEY=""
# Sender identity; requires a Resend-verified domain in production.
# Default when unset: "Primary Brain Health <onboarding@resend.dev>"
EMAIL_FROM=""
# Absolute URL of the email header logo. Default when unset:
# {BOOKING_BASE_URL}/email-assets/pbh-logo.png (served from this app's public/).
# Point it at a stable production/CDN URL before launch.
EMAIL_LOGO_URL=""
# Where the account-deletion notice goes — Linus's CS desk, who deactivate the
# subject on their side by hand because no API does it yet. No default: unset,
# the notice is skipped and logged, and nobody at Linus hears about the request.
ACCOUNT_DELETION_NOTICE_TO=""
# The /internal/emails template preview page is visible on dev/preview
# deployments and hidden in production; set to "1" to expose it in production.
EMAIL_PREVIEW_ENABLED=""

# --- Auth.js (NextAuth) — sessions ---
#
# Auth.js owns the session; Auth0 (below) authenticates. Sign-in is how a
# returning customer gets back to /welcome — the post-payment session is minted
# directly by the checkout action, so it is the alternative entry rather than
# the main one.
#
# Secret used to encrypt session tokens. REQUIRED in production.
# Local dev:  generate one with `npx auth secret` (or `openssl rand -base64 32`).
# Vercel:     set per environment (a distinct value for prod vs preview).
AUTH_SECRET=""
# Canonical origin Auth.js builds callback URLs against. On Vercel it is
# inferred automatically; set it only for local dev if the default
# (http://localhost:3000) is wrong, or for non-Vercel hosts.
# AUTH_URL="http://localhost:3000"

# --- Auth0 (the sign-in provider) ---
#
# Linus's Engagement App is the entry point for both PBH experiences and it
# authenticates with Auth0, so PBH signs people in against the same Auth0 tenant
# rather than keeping a separate identity. Auth0 authenticates; the session is
# still ours (database sessions in Neon) — see the "Auth0" section of
# docs/auth.md for why that split matters.
#
# It is also what verifies the address at signup: the booking form redirects
# here, and entering Auth0's emailed code is what stamps users.email_verified.
#
# WHICH TENANT is an open question with Linus: theirs (prod-linus-us /
# stgint-linus-us) or a PBH-owned one. Nothing here assumes an answer — point it
# at whichever tenant you have, starting with a personal sandbox.
#
# NOT the same thing as the LINUS_* variables near the top of this file. Those
# are machine-to-machine client credentials for calling the Linus Public API,
# which happens to sit behind Auth0. These sign in a human.
#
# Auth0 Dashboard → Applications → a Regular Web Application. Add
#   http://localhost:3000/api/auth/callback/auth0
# to its Allowed Callback URLs, and http://localhost:3000 to Allowed Logout URLs
# (swap in the deployment origin for a preview or production).
#
# REQUIRED. With all three unset there is no way to sign in and no way to
# complete a signup — Auth0 is the only provider, and the magic link that used
# to stand behind it was removed in Sep 2026.
AUTH0_ISSUER=""
AUTH0_CLIENT_ID=""
AUTH0_CLIENT_SECRET=""
